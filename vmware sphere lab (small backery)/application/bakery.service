[Unit]
Description=MokTech Bakery Web Application
After=network.target postgresql.service

[Service]
Type=simple
User=bakery
Group=bakery
WorkingDirectory=/opt/bakery
EnvironmentFile=/opt/bakery/.env
ExecStart=/opt/bakery/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
